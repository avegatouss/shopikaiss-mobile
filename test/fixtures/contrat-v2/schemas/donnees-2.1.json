{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "donnees-2.1.json",
    "title": "Données des changements, forme 2.1 (rendue aux clients qui annoncent contrat.2_1 ; REVISION-2.1 §7.1). Les autres reçoivent la forme 2.0 de donnees.json.",
    "$defs": {
        "produit": {
            "type": "object",
            "required": [
                "nom",
                "reference",
                "categorie",
                "prix",
                "stock_illimite",
                "actif",
                "vente_locale",
                "categorie_uuid",
                "marque",
                "fournisseur",
                "unite",
                "prix_gros",
                "gros_quantite_min",
                "seuil_alerte",
                "cree_le",
                "favori",
                "promotions",
                "image"
            ],
            "additionalProperties": false,
            "properties": {
                "nom": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                },
                "reference": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 100
                },
                "categorie": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 120
                },
                "prix": {
                    "$ref": "commun.json#/$defs/montant"
                },
                "stock_illimite": {
                    "type": "boolean"
                },
                "actif": {
                    "type": "boolean"
                },
                "vente_locale": {
                    "type": "boolean",
                    "description": "Faux : produit vendable seulement en ligne (variantes, coffrets, lots…) ; le client l'affiche avec ce motif."
                },
                "categorie_uuid": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/uuid"
                        }
                    ]
                },
                "marque": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 120
                },
                "fournisseur": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 200
                },
                "unite": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "object",
                            "required": [
                                "code",
                                "nom"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "code": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "maxLength": 20
                                },
                                "nom": {
                                    "type": "string",
                                    "maxLength": 120
                                }
                            }
                        }
                    ]
                },
                "prix_gros": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/montant"
                        }
                    ]
                },
                "gros_quantite_min": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/quantite"
                        }
                    ]
                },
                "seuil_alerte": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/quantite"
                        }
                    ]
                },
                "cree_le": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/horodatage"
                        }
                    ]
                },
                "favori": {
                    "type": "boolean"
                },
                "promotions": {
                    "type": "array",
                    "description": "Bons affichés en badge « Promotion », par priorité : le premier dont la période couvre la date locale de la boutique et hors exclusions. Présentation seule : aucune remise appliquée, aucun prix avant/après.",
                    "items": {
                        "type": "object",
                        "required": [
                            "libelle",
                            "du",
                            "au",
                            "exclusions"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "libelle": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 300
                            },
                            "du": {
                                "oneOf": [
                                    {
                                        "type": "null"
                                    },
                                    {
                                        "type": "string",
                                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                                    }
                                ]
                            },
                            "au": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                            },
                            "exclusions": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "du",
                                        "au"
                                    ],
                                    "additionalProperties": false,
                                    "properties": {
                                        "du": {
                                            "type": "string",
                                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                                        },
                                        "au": {
                                            "type": "string",
                                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "image": {
                    "description": "Image principale ; à télécharger hors vente par GET /images/{uuid}.",
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "object",
                            "required": [
                                "uuid",
                                "empreinte",
                                "octets",
                                "largeur",
                                "hauteur"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "uuid": {
                                    "$ref": "commun.json#/$defs/uuid"
                                },
                                "empreinte": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{64}$"
                                },
                                "octets": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "largeur": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "hauteur": {
                                    "type": "integer",
                                    "minimum": 1
                                }
                            }
                        }
                    ]
                },
                "gere_par_lots": {
                    "type": "boolean",
                    "description": "Capacité lots.vente seulement : produit vendu par lot, avec vente_locale selon actif. Sa quantité se lit sur les stock.projection produit:lot."
                }
            }
        },
        "conditionnement": {
            "type": "object",
            "required": [
                "produit_uuid",
                "nom",
                "coefficient",
                "prix",
                "defaut",
                "actif",
                "prix_gros"
            ],
            "additionalProperties": false,
            "properties": {
                "produit_uuid": {
                    "$ref": "commun.json#/$defs/uuid"
                },
                "nom": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "coefficient": {
                    "$ref": "commun.json#/$defs/quantite"
                },
                "prix": {
                    "$ref": "commun.json#/$defs/montant"
                },
                "defaut": {
                    "type": "boolean"
                },
                "actif": {
                    "type": "boolean"
                },
                "prix_gros": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/montant"
                        }
                    ]
                }
            }
        },
        "code_barre": {
            "type": "object",
            "required": [
                "code",
                "produit_uuid",
                "conditionnement_uuid"
            ],
            "additionalProperties": false,
            "properties": {
                "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                },
                "produit_uuid": {
                    "$ref": "commun.json#/$defs/uuid"
                },
                "conditionnement_uuid": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/uuid"
                        }
                    ]
                }
            }
        },
        "moyen_paiement": {
            "type": "object",
            "required": [
                "code",
                "nom",
                "especes",
                "local",
                "reference"
            ],
            "additionalProperties": false,
            "properties": {
                "code": {
                    "$ref": "commun.json#/$defs/code"
                },
                "nom": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "especes": {
                    "type": "boolean"
                },
                "local": {
                    "type": "boolean",
                    "description": "Admis pour une vente locale (paiements.moyens_locaux)."
                },
                "reference": {
                    "enum": [
                        "aucune",
                        "facultative",
                        "obligatoire"
                    ],
                    "description": "Référence de transaction : réglage Trésorerie du web (references_required) ; espèces, crédit, compte client, carte cadeau : aucune."
                }
            }
        },
        "operateur": {
            "description": "Opérateur autorisé sur ce terminal. Le PIN n'est transmis que sous forme d'empreinte lente (bcrypt), jamais en clair.",
            "type": "object",
            "required": [
                "operateur_id",
                "nom",
                "pin_empreinte",
                "droits",
                "remise_max_pourcent",
                "remise_max_montant",
                "approbateur_remise"
            ],
            "additionalProperties": false,
            "properties": {
                "operateur_id": {
                    "$ref": "commun.json#/$defs/identifiant_serveur"
                },
                "nom": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "pin_empreinte": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 100,
                    "description": "null quand la politique demande un PIN : l’opérateur n’a pas défini de PIN ; le refuser avec le motif « PIN non défini », sans compter d’échec."
                },
                "droits": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 100,
                    "items": {
                        "$ref": "commun.json#/$defs/code"
                    }
                },
                "remise_max_pourcent": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/taux"
                        }
                    ]
                },
                "remise_max_montant": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/montant"
                        }
                    ]
                },
                "approbateur_remise": {
                    "type": "boolean"
                },
                "code_autorisation_empreinte": {
                    "description": "Empreinte bcrypt (coût ≥ 12) du code de 8 chiffres d’un approbateur. Clé absente : pas de code publiable, autorisation hors ligne impossible pour lui. Jamais le PIN.",
                    "type": "string",
                    "minLength": 59,
                    "maxLength": 60
                }
            }
        },
        "stock.projection": {
            "description": "Projection absolue versionnée pour la clé (produit, ou produit:lot). Jamais un delta.",
            "type": "object",
            "required": [
                "produit_uuid",
                "lot_uuid",
                "quantite"
            ],
            "additionalProperties": false,
            "properties": {
                "produit_uuid": {
                    "$ref": "commun.json#/$defs/uuid"
                },
                "lot_uuid": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/uuid"
                        }
                    ]
                },
                "quantite": {
                    "$ref": "commun.json#/$defs/quantite_signee"
                }
            }
        },
        "politique": {
            "description": "Valeur effective calculée par le serveur (03). Le client n'applique aucune logique d'héritage. Clé inconnue critique : restriction, jamais de défaut permissif.",
            "type": "object",
            "required": [
                "cle_politique",
                "valeur",
                "source",
                "verrouillee"
            ],
            "additionalProperties": false,
            "properties": {
                "cle_politique": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                },
                "valeur": {
                    "description": "Valeur JSON (entier, chaîne, booléen, liste ou null) ; jamais de nombre à virgule."
                },
                "source": {
                    "enum": [
                        "defaut",
                        "entreprise",
                        "boutique",
                        "terminal"
                    ]
                },
                "verrouillee": {
                    "type": "boolean"
                }
            }
        },
        "boutique": {
            "description": "Révision 2.0.1 (B-REQ-005) : paramètres de calcul de la boutique. Critique : un changement de TVA modifie le total des ventes suivantes ; une vente déjà commise garde la TVA qu'elle a figée.",
            "type": "object",
            "required": [
                "nom",
                "devise",
                "tva_taux",
                "tva_incluse",
                "regles",
                "ticket",
                "devise_secondaire"
            ],
            "additionalProperties": false,
            "properties": {
                "nom": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                },
                "devise": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10
                },
                "tva_taux": {
                    "$ref": "commun.json#/$defs/taux"
                },
                "tva_incluse": {
                    "type": "boolean"
                },
                "regles": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "remise_pourcentage_arrondi",
                        "arrondi_especes",
                        "trop_percu",
                        "moins_a_un",
                        "livraison_droit",
                        "ouverture_session",
                        "survente",
                        "gros",
                        "fuseau",
                        "nouveau_jours"
                    ],
                    "description": "Codes du web, tels quels (PARITE-CAISSE-WEB §3).",
                    "properties": {
                        "remise_pourcentage_arrondi": {
                            "enum": [
                                "down",
                                "nearest"
                            ]
                        },
                        "arrondi_especes": {
                            "oneOf": [
                                {
                                    "type": "null"
                                },
                                {
                                    "type": "object",
                                    "required": [
                                        "pas",
                                        "mode"
                                    ],
                                    "additionalProperties": false,
                                    "properties": {
                                        "pas": {
                                            "type": "integer",
                                            "minimum": 1
                                        },
                                        "mode": {
                                            "type": "string",
                                            "maxLength": 40
                                        }
                                    }
                                }
                            ]
                        },
                        "trop_percu": {
                            "enum": [
                                "refuse",
                                "customer_advance",
                                "cash_change"
                            ]
                        },
                        "moins_a_un": {
                            "enum": [
                                "refuse",
                                "remove"
                            ]
                        },
                        "livraison_droit": {
                            "oneOf": [
                                {
                                    "type": "null"
                                },
                                {
                                    "$ref": "commun.json#/$defs/code"
                                }
                            ]
                        },
                        "ouverture_session": {
                            "enum": [
                                "payment",
                                "before_sale",
                                "automatic"
                            ]
                        },
                        "survente": {
                            "type": "string",
                            "maxLength": 40
                        },
                        "gros": {
                            "type": "object",
                            "required": [
                                "actif",
                                "mode",
                                "quantite_min",
                                "droit",
                                "remises",
                                "prix_lot"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "actif": {
                                    "type": "boolean"
                                },
                                "mode": {
                                    "enum": [
                                        "cart",
                                        "quantity",
                                        "cart_and_quantity"
                                    ]
                                },
                                "quantite_min": {
                                    "oneOf": [
                                        {
                                            "type": "null"
                                        },
                                        {
                                            "$ref": "commun.json#/$defs/quantite"
                                        }
                                    ]
                                },
                                "droit": {
                                    "oneOf": [
                                        {
                                            "type": "null"
                                        },
                                        {
                                            "$ref": "commun.json#/$defs/code"
                                        }
                                    ]
                                },
                                "remises": {
                                    "enum": [
                                        "refuse",
                                        "allow"
                                    ]
                                },
                                "prix_lot": {
                                    "enum": [
                                        "refuse",
                                        "lot_price",
                                        "lowest"
                                    ]
                                }
                            }
                        },
                        "fuseau": {
                            "type": "string",
                            "maxLength": 64
                        },
                        "nouveau_jours": {
                            "description": "Badge « Nouveau » : produit créé depuis N jours au plus ; null = désactivé.",
                            "oneOf": [
                                {
                                    "type": "null"
                                },
                                {
                                    "type": "integer",
                                    "minimum": 1
                                }
                            ]
                        },
                        "retour_residuel": {
                            "description": "Règle du reste d'arrondi d'un retour partiel (référentiel §3.13). Facultative : reçue avec la capacité retour.especes.",
                            "enum": [
                                "refuse",
                                "last_line",
                                "largest_share",
                                "largest_fraction"
                            ]
                        },
                        "lots_mode": {
                            "enum": [
                                "fifo",
                                "dernier_achat",
                                "prix_bas",
                                "fefo",
                                "manuel",
                                "prix_unique"
                            ],
                            "description": "Capacité lots.vente seulement : règle d’allocation de la boutique, même sens que la caisse web."
                        }
                    }
                },
                "ticket": {
                    "type": "object",
                    "required": [
                        "raison_sociale",
                        "adresse",
                        "telephone",
                        "ncc",
                        "entete",
                        "pied",
                        "largeur_papier"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "raison_sociale": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 160
                        },
                        "adresse": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 500
                        },
                        "telephone": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 60
                        },
                        "ncc": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 60
                        },
                        "entete": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 1000
                        },
                        "pied": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 1000
                        },
                        "largeur_papier": {
                            "type": "integer",
                            "minimum": 30,
                            "maximum": 120
                        }
                    }
                },
                "devise_secondaire": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "object",
                            "required": [
                                "libelle",
                                "taux"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "libelle": {
                                    "type": "string",
                                    "maxLength": 20
                                },
                                "taux": {
                                    "$ref": "commun.json#/$defs/quantite",
                                    "description": "Unités de la devise secondaire pour 1 unité de la devise de la boutique ou l'inverse, tel que saisi au web ; format quantité (6 décimales)."
                                }
                            }
                        }
                    ]
                }
            }
        },
        "autorisation": {
            "type": "object",
            "required": [
                "vente_locale",
                "version",
                "expire_le"
            ],
            "additionalProperties": false,
            "properties": {
                "vente_locale": {
                    "type": "boolean"
                },
                "version": {
                    "$ref": "commun.json#/$defs/version"
                },
                "expire_le": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/horodatage"
                        }
                    ]
                }
            }
        },
        "revocation": {
            "description": "Révocation de l'appareil ou de ses droits de vente : bloquer toute nouvelle vente dès application ; conserver la file.",
            "type": "object",
            "required": [
                "portee",
                "raison"
            ],
            "additionalProperties": false,
            "properties": {
                "portee": {
                    "enum": [
                        "appareil",
                        "vente_locale",
                        "operateur"
                    ]
                },
                "operateur_id": {
                    "$ref": "commun.json#/$defs/identifiant_serveur"
                },
                "raison": {
                    "$ref": "commun.json#/$defs/raison"
                }
            }
        },
        "session": {
            "type": "object",
            "required": [
                "session_uuid",
                "ouverte",
                "ouverte_le",
                "operateur_id"
            ],
            "additionalProperties": false,
            "properties": {
                "session_uuid": {
                    "$ref": "commun.json#/$defs/uuid"
                },
                "ouverte": {
                    "type": "boolean"
                },
                "ouverte_le": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/horodatage"
                        }
                    ]
                },
                "operateur_id": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/identifiant_serveur"
                        }
                    ]
                }
            }
        },
        "operation_etat": {
            "description": "Changement d'état d'une opération du terminal (intégration, arbitrage, résolution) : la résolution revient aux terminaux par le journal.",
            "type": "object",
            "required": [
                "operation_uuid",
                "etat",
                "version_etat",
                "raison"
            ],
            "additionalProperties": false,
            "properties": {
                "operation_uuid": {
                    "$ref": "commun.json#/$defs/uuid"
                },
                "etat": {
                    "enum": [
                        "recue",
                        "integree",
                        "a_arbitrer",
                        "resolue",
                        "rejet_protocole"
                    ]
                },
                "version_etat": {
                    "$ref": "commun.json#/$defs/version"
                },
                "raison": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/raison"
                        }
                    ]
                },
                "details": {
                    "type": "object",
                    "description": "Sur une creation_client intégrée (capacité client.creation) ou une cloture_session intégrée (capacité session.cloture).",
                    "additionalProperties": false,
                    "properties": {
                        "client_uuid_canonique": {
                            "$ref": "commun.json#/$defs/uuid"
                        },
                        "z": {
                            "type": "object",
                            "description": "Z de la clôture intégrée.",
                            "required": [
                                "cloture_uuid",
                                "compte",
                                "theorique",
                                "ecart",
                                "mode"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "cloture_uuid": {
                                    "$ref": "commun.json#/$defs/uuid"
                                },
                                "compte": {
                                    "$ref": "commun.json#/$defs/montant"
                                },
                                "theorique": {
                                    "type": "integer"
                                },
                                "ecart": {
                                    "type": "integer"
                                },
                                "mode": {
                                    "enum": [
                                        "V1",
                                        "COMPLETE"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "categorie": {
            "description": "Révision 2.1 : catégorie du catalogue (onglets de la caisse web). Non critique.",
            "type": "object",
            "required": [
                "nom",
                "ordre",
                "actif"
            ],
            "additionalProperties": false,
            "properties": {
                "nom": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "ordre": {
                    "type": "integer"
                },
                "actif": {
                    "type": "boolean"
                }
            }
        },
        "client": {
            "description": "Client actif de la boutique (capacité client.lecture). Aucun solde : crédit, points et avoirs restent en ligne.",
            "type": "object",
            "required": [
                "nom",
                "telephone",
                "type",
                "tarif",
                "actif"
            ],
            "additionalProperties": false,
            "properties": {
                "nom": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "telephone": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^\\+[1-9][0-9]{7,14}$",
                    "description": "E.164 ; null si absent ou illisible."
                },
                "type": {
                    "enum": [
                        "particulier",
                        "professionnel",
                        "passage"
                    ]
                },
                "tarif": {
                    "enum": [
                        "detail",
                        "gros"
                    ]
                },
                "actif": {
                    "type": "boolean"
                }
            }
        },
        "contenu_panier": {
            "type": "object",
            "required": [
                "lignes",
                "client_uuid",
                "client_nom",
                "remise_globale",
                "livraison",
                "note",
                "tarif"
            ],
            "additionalProperties": false,
            "properties": {
                "lignes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                        "type": "object",
                        "required": [
                            "produit_uuid",
                            "conditionnement_uuid",
                            "libelle",
                            "quantite",
                            "coefficient",
                            "prix_unitaire",
                            "remise"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "produit_uuid": {
                                "$ref": "commun.json#/$defs/uuid"
                            },
                            "conditionnement_uuid": {
                                "oneOf": [
                                    {
                                        "type": "null"
                                    },
                                    {
                                        "$ref": "commun.json#/$defs/uuid"
                                    }
                                ]
                            },
                            "libelle": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 400
                            },
                            "quantite": {
                                "type": "string"
                            },
                            "coefficient": {
                                "type": "string"
                            },
                            "prix_unitaire": {
                                "$ref": "commun.json#/$defs/montant",
                                "description": "Prix figé à la suspension."
                            },
                            "remise": {
                                "$ref": "commun.json#/$defs/montant"
                            }
                        }
                    }
                },
                "client_uuid": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "commun.json#/$defs/uuid"
                        }
                    ]
                },
                "client_nom": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 255
                },
                "remise_globale": {
                    "$ref": "commun.json#/$defs/montant"
                },
                "livraison": {
                    "$ref": "commun.json#/$defs/montant"
                },
                "note": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 2000
                },
                "tarif": {
                    "enum": [
                        "detail",
                        "gros"
                    ]
                }
            }
        },
        "panier": {
            "description": "Panier partagé en attente ou repris, de moins de 30 jours (capacité panier.partage). Vendu ou supprimé : suppression au journal.",
            "type": "object",
            "required": [
                "etat",
                "libelle",
                "auteur_operateur_id",
                "terminal_origine_uuid",
                "terminaux",
                "repris_par",
                "contenu",
                "cree_le",
                "modifie_le"
            ],
            "additionalProperties": false,
            "properties": {
                "etat": {
                    "enum": [
                        "en_attente",
                        "repris"
                    ]
                },
                "libelle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                },
                "auteur_operateur_id": {
                    "$ref": "commun.json#/$defs/identifiant_serveur"
                },
                "terminal_origine_uuid": {
                    "$ref": "commun.json#/$defs/uuid"
                },
                "terminaux": {
                    "description": "Terminaux de son point de vente : les seuls à pouvoir le lister et le reprendre.",
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                        "$ref": "commun.json#/$defs/uuid"
                    }
                },
                "repris_par": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "object",
                            "required": [
                                "terminal_uuid",
                                "operateur_id",
                                "le"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "terminal_uuid": {
                                    "oneOf": [
                                        {
                                            "type": "null"
                                        },
                                        {
                                            "$ref": "commun.json#/$defs/uuid"
                                        }
                                    ]
                                },
                                "operateur_id": {
                                    "$ref": "commun.json#/$defs/identifiant_serveur"
                                },
                                "le": {
                                    "$ref": "commun.json#/$defs/horodatage"
                                }
                            }
                        }
                    ]
                },
                "contenu": {
                    "$ref": "#/$defs/contenu_panier"
                },
                "cree_le": {
                    "$ref": "commun.json#/$defs/horodatage"
                },
                "modifie_le": {
                    "$ref": "commun.json#/$defs/horodatage"
                }
            }
        },
        "lot": {
            "description": "Capacité lots.vente : lot d’un produit. Quantité sur la stock.projection de clé produit:lot.",
            "type": "object",
            "required": [
                "produit_uuid",
                "reference",
                "entree",
                "peremption",
                "prix_vente",
                "actif"
            ],
            "additionalProperties": false,
            "properties": {
                "produit_uuid": {
                    "$ref": "commun.json#/$defs/uuid"
                },
                "reference": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 255
                },
                "entree": {
                    "type": "string",
                    "description": "Date d’entrée UTC, ordre des modes fifo et dernier_achat."
                },
                "peremption": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                        }
                    ]
                },
                "prix_vente": {
                    "type": "integer",
                    "minimum": 0
                },
                "actif": {
                    "type": "boolean"
                }
            }
        }
    }
}
